{
  "expo": {
    "name": "MapFarma",
    "slug": "mapfarma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mapfarma",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#E5CDF5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonny5134.mapfarma"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00D6BD"
      },
      "package": "com.sonny5134.mapfarma"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ]
  }
}

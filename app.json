{
  "expo": {
    "name": "MapFarma",
    "slug": "mapfarma",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mapfarma",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sonny5134.mapfarma"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#00D6BD"
      },
      "package": "com.sonny5134.mapfarma"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#E5CDF5",
          "imageWidth": 200
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MapFarma usa tu ubicación para mostrarte las farmacias más cercanas."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MapFarma accede a tus fotos para que puedas adjuntar la receta o la foto de un medicamento.",
          "cameraPermission": "MapFarma usa la cámara para sacar la foto de la receta o de un medicamento."
        }
      ]
    ]
  }
}

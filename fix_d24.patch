+// components/SoloDesarrolladores.tsx
+import { useMemo } from 'react';
+import { View, Text, StyleSheet } from 'react-native';
+import { Ionicons } from '@expo/vector-icons';
+import { Spacing, FontSize, FontFamily, ThemeColors } from '../constants/theme';
+import { useTheme } from '../contexts/ThemeContext';
+
+// Aviso que se muestra si alguien sin rol Desarrollador llega a una pantalla de publicación.
+export function SoloDesarrolladores() {
+  const { colors: Colors } = useTheme();
+  const styles = useMemo(() => makeStyles(Colors), [Colors]);
+  return (
+    <View style={styles.container} accessibilityRole="alert">
+      <Ionicons name="lock-closed-outline" size={40} color={Colors.textMuted as string} />
+      <Text style={styles.title}>Solo para desarrolladores</Text>
+      <Text style={styles.text}>Tu cuenta es de Cliente: podés buscar medicamentos y hacer pedidos, pero no publicarlos.</Text>
+    </View>
+  );
+}
+
+const makeStyles = (Colors: ThemeColors) =>
+  StyleSheet.create({
+    container: { flex: 1, alignItems: 'center', justifyContent: 'center', padding: Spacing.xl, backgroundColor: Colors.background },
+    title: { marginTop: Spacing.md, fontSize: FontSize.lg, fontFamily: FontFamily.bold, color: Colors.text },
+    text: { marginTop: Spacing.sm, textAlign: 'center', fontSize: FontSize.md, fontFamily: FontFamily.regular, color: Colors.textMuted },
+  });
diff --git a/firestore.rules b/firestore.rules
index 0e1b122..1133ab9 100644
--- a/firestore.rules
+++ b/firestore.rules
@@ -8,12 +8,18 @@ service cloud.firestore {
       allow write: if false;
     }
 
-    // Medicamentos: leer con sesión; crear solo a nombre propio;
+    // Solo el rol Desarrollador (campo "rol" de usuarios/{uid}) puede publicar medicamentos.
+    function esDesarrollador() {
+      return request.auth != null
+        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get('rol', 'Cliente') == 'Desarrollador';
+    }
+
+    // Medicamentos: leer con sesión; crear solo un Desarrollador y a nombre propio;
     // modificar o borrar SOLO el dueño original (userId == UID de quien pide).
     match /medicamentos/{medicamentoId} {
       allow read: if request.auth != null;
 
-      allow create: if request.auth != null
+      allow create: if esDesarrollador()
                     && request.resource.data.userId == request.auth.uid;
 
       allow update: if request.auth != null
diff --git a/utils/permisos.ts b/utils/permisos.ts
new file mode 100644
index 0000000..30f4825
--- /dev/null
+++ b/utils/permisos.ts
@@ -0,0 +1,6 @@
+// utils/permisos.ts
+import { Rol } from '../types';
+
+// Solo el rol Desarrollador puede publicar, editar y administrar medicamentos (RF-015, RF-019).
+// Clientes, y cualquier rol sin definir, solo consultan el catálogo y compran.
+export const puedePublicar = (rol?: Rol | null): boolean => rol === 'Desarrollador';
